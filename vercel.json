{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/docs/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"bassroom-dosier.pdf\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/reservar",
      "destination": "https://calendar.app.google/jAWiXbuMA2pQXPar5",
      "permanent": false
    },
    {
      "source": "/reservar/",
      "destination": "https://calendar.app.google/jAWiXbuMA2pQXPar5",
      "permanent": false
    }
  ]
}
